PORT=8080
ADMIN_PORT=9100
IDENTITY_SERVICE_URL=identity:50060
# Observabilidad (docs/standards/observability-standards.md)
LOG_LEVEL=info
DEPLOY_ENV=dev
# Trazas: vacío = no se exportan (los logs igual llevan trace_id). `console` = una línea JSON por span en stdout.
OTEL_TRACES_EXPORTER=
# Colector OTLP gRPC (F04.1). Si se define, tiene prioridad sobre OTEL_TRACES_EXPORTER.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://observability:4317

# Llave S3 de catalog_svc (solo pp-catalog-media, ADR 0021). La crea object-storage al arrancar:
#   docker exec plentypay-object-storage-1 /usr/local/bin/garage key info catalog_svc --show-secret
S3_KEY_ID=
S3_SECRET_KEY=
