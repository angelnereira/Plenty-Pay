PORT=50060
ADMIN_PORT=9100
# openssl rand -base64 48  — dos valores DISTINTOS, ≥ 32 caracteres
ACCESS_TOKEN_SECRET=CAMBIAR
REFRESH_TOKEN_SECRET=CAMBIAR-OTRO-VALOR
# Observabilidad (docs/standards/observability-standards.md)
LOG_LEVEL=info
DEPLOY_ENV=dev
# Trazas: vacío = no se exportan (los logs igual llevan trace_id). `console` = una línea JSON por span en stdout.
OTEL_TRACES_EXPORTER=
# Colector OTLP gRPC (F04.1). Si se define, tiene prioridad sobre OTEL_TRACES_EXPORTER.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://observability:4317

# PostgreSQL (F08.2). Vacio = store en memoria (pruebas/E2E sin BD).
# host pgbouncer:6432 (modo transaccion); usuario identity_svc del esquema identity.
# Sin search_path en el DSN: PgBouncer en modo transaccion lo rechaza como parametro
# de arranque; el rol identity_svc ya lo trae por defecto (postgres-db init).
PP_DB_DSN=postgres://identity_svc:identity_svc_dev_secret_32_chars!@pgbouncer:6432/plentypay?sslmode=disable
