# Observabilidad (F04). Ningún valor es secreto salvo la contraseña de Grafana (SPEC R3).
DEPLOY_ENV=dev
# Retenciones (SPEC R2)
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=30d
TEMPO_RETENTION=7d
# Grafana: solo se publica en 127.0.0.1 (perfil observability). SSO de identity en F28.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambiar-en-local
# Colector: muestreo de cola (observability-standards.md §3.4)
OTEL_TAIL_SAMPLING_PERCENTAGE=10
OTEL_SLOW_TRACE_THRESHOLD_MS=1000
