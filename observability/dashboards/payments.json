{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Métricas Críticas de Pagos (SLO §5)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Pagos CAPTURED Sin Asiento (> 5 min)",
      "type": "stat",
      "targets": [{ "expr": "sum(pp_payments_captured_unposted_current) or vector(0)", "legendFormat": "Sin Asiento" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Pagos en UNKNOWN (> 1 h)",
      "type": "stat",
      "targets": [{ "expr": "sum(pp_payments_unknown_current) or vector(0)", "legendFormat": "En UNKNOWN" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.8 }, { "color": "red", "value": 0.5 }] },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Conversión (Intent → Captured)",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(pp_payments_status_total{status=\"CAPTURED\"}[5m])) / clamp_min(sum(rate(pp_payments_status_total{status=\"INTENT\"}[5m])), 1)", "legendFormat": "Conversión" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "title": "Volumen y Latencia por Riel",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "title": "Volumen de Transacciones por Riel",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (rail) (rate(pp_payments_transactions_total[1m]))", "legendFormat": "Riel: {{rail}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "title": "Latencia p95 por Riel",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, rail) (rate(pp_payments_rail_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{rail}}" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["plentypay", "payments"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "PlentyPay — Pagos",
  "uid": "pp-payments",
  "version": 1
