{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Salud y Disponibilidad",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Estado de Servicios (:9100)",
      "type": "stat",
      "targets": [{ "expr": "up{job=\"plentypay-services\"}", "legendFormat": "{{instance}}" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Pánicos Recuperados (Total)",
      "type": "stat",
      "targets": [{ "expr": "sum(pp_panics_total)", "legendFormat": "Pánicos" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Versión en Ejecución",
      "type": "stat",
      "targets": [{ "expr": "count by (service, version) (pp_build_info)", "legendFormat": "{{service}} ({{version}})" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 5,
      "title": "RED — Rate, Errors, Duration",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "id": 6,
      "title": "Tasa de Peticiones (Rate)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (service) (rate(pp_http_requests_total[1m]))", "legendFormat": "HTTP: {{service}}" },
        { "expr": "sum by (service) (rate(pp_rpc_server_requests_total[1m]))", "legendFormat": "gRPC: {{service}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "id": 7,
      "title": "Errores por Segundo (Errors)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (service) (rate(pp_http_requests_total{status=~\"5..\"}[1m]))", "legendFormat": "HTTP 5xx: {{service}}" },
        { "expr": "sum by (service) (rate(pp_rpc_server_requests_total{code!=\"OK\"}[1m]))", "legendFormat": "gRPC Error: {{service}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 8,
      "title": "Latencia p95 (Duration)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, service) (rate(pp_rpc_server_duration_seconds_bucket[5m])))", "legendFormat": "p95 gRPC: {{service}}" }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["plentypay", "red", "overview"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "PlentyPay — Visión General",
  "uid": "pp-overview",
  "version": 1
}
