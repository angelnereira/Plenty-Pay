      "title": "Duración de Conciliación",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(pp_settlement_reconcile_duration_seconds_bucket[5m]))) or vector(0)", "legendFormat": "p95" }]
