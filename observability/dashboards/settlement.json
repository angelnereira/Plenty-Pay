        }
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Discrepancias de Conciliación",
      "type": "stat",
      "targets": [{ "expr": "sum(pp_settlement_discrepancies_total) or vector(0)", "legendFormat": "Discrepancias" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
