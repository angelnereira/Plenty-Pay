# ========================================
# PlentyPay - Variables de Entorno TEMPLATE
# ========================================
# 
# INSTRUCCIONES:
# 1. Copiar este archivo como .env: cp env.template .env
# 2. Rellenar todas las variables con valores reales
# 3. NUNCA subir .env a Git (ya está en .gitignore)
# ========================================

# ========================================
# DATABASE - Neon PostgreSQL
# ========================================
# Conexión principal pooled para la aplicación
# Obtener de: https://console.neon.tech/ > Connection Details
#
# IMPORTANTE: Usar el endpoint correcto según el ambiente:
#
# PRODUCCIÓN (rama Git: main | rama Neon: production)
#   Endpoint: <PROD_ENDPOINT_ID>-pooler
#   Solo se configura en Vercel con scope Production. NUNCA usarla en local.
#
# DESARROLLO / PREVIEW / STAGING (rama Git: Development/preview | rama Neon: development-preview)
#   Endpoint: <DEV_ENDPOINT_ID>-pooler
#   Único ambiente de desarrollo y pruebas. Configurar en Vercel con scope Preview.
#
# HOTFIX (rama Git: Hotfix)
#   Usa la misma rama Neon de desarrollo (o una hija efímera de production
#   creada para reproducir el incidente — ver docs/NEON-CHILD-BRANCH-SETUP.md).
#
# Para desarrollo local, usar SIEMPRE el endpoint de desarrollo.
# Vercel inyectará la URL correcta según el scope configurado.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&channel_binding=require"

# ========================================
# NEXTAUTH.JS - Sesiones y JWT
# ========================================
# URL base - CAMBIAR según ambiente:
#   - Desarrollo: http://localhost:3000
#   - Producción: https://plentypay.com
NEXTAUTH_URL="http://localhost:3000"

# Secret para JWT - Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secret-key-aqui-generado-con-openssl"

# ========================================
# THE FACTORY HKA - Facturación Electrónica
# ========================================
# La configuración de ambiente (demo/prod) y credenciales se maneja 
# ahora a nivel de base de datos por cada cliente/usuario.
# No es necesario configurar estas variables en el archivo .env.

# ========================================
# APP CONFIGURATION
# ========================================
# Nombre y URL pública de la aplicación
NEXT_PUBLIC_APP_NAME="PlentyPay"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ========================================
# SUPER ADMIN - Usuario Inicial
# ========================================
# Credenciales del Super Admin para seed inicial
# CAMBIAR en producción con valores seguros
SUPER_ADMIN_EMAIL="admin@tudominio.com"
SUPER_ADMIN_PASSWORD="cambiar-por-password-seguro"

# ========================================
# FEATURE FLAGS
# ========================================
# Habilitar/deshabilitar funcionalidades
ENABLE_EMAIL_NOTIFICATIONS="false"

# ========================================
# CERTIFICADOS DIGITALES
# ========================================
# Clave para cifrado de credenciales sensibles (HKA, etc.)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY="tu-clave-hex-64-caracteres"

# ========================================
# EMAIL SERVICE - Resend
# ========================================
# API para envío de correos transaccionales
# Obtener de: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxx"

# Remitente por defecto (notificaciones transaccionales: activaciones, aprobaciones, alertas)
EMAIL_FROM="PlentyPay <notifications@plentypay.com>"

# Remitentes especializados por tipo de correo
# Si no se definen, el código usa los valores hardcoded como fallback.
EMAIL_FROM_RECOVERY="PlentyPay <recovery@plentypay.com>"
EMAIL_FROM_SUPPORT="PlentyPay <soporte@plentypay.com>"
EMAIL_FROM_MARKETING="PlentyPay <marketing@plentypay.com>"

ADMIN_EMAIL="admin@plentypay.com"

# ========================================
# CLOUDINARY - Almacenamiento de Imágenes
# ========================================
# Configuración de Cloudinary para uploads
# Obtener de: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu-cloud-name"
NEXT_PUBLIC_CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"

# ========================================
# REDIS - Cache y Colas
# ========================================
# Redis para caching y BullMQ
# Local: redis://localhost:6379
# Upstash: rediss://default:password@host:port
REDIS_URL="redis://localhost:6379"

# ========================================
# MONITORING - Sentry
# ========================================
# Error tracking y performance monitoring
# Obtener de: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN="https://public@sentry.io/project-id"
SENTRY_AUTH_TOKEN="tu-auth-token"

# ========================================
# PWA - Push Notifications (VAPID)
# ========================================
# Claves VAPID para Web Push Notifications
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="tu-clave-publica-vapid"
VAPID_PRIVATE_KEY="tu-clave-privada-vapid"
NEXT_PUBLIC_VAPID_SUBJECT="mailto:admin@tudominio.com"

# ========================================
# RATE LIMITING - Upstash Redis
# ========================================
# Usado por core/middleware/rate-limit.ts
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu-token-upstash"

# ========================================
# CRON JOBS - Vercel Cron
# ========================================
# Secret para autenticar los endpoints /api/cron/* (header Authorization)
CRON_SECRET="generar-con-openssl-rand-base64-32"

# ========================================
# SEGURIDAD / CORS
# ========================================
# Orígenes permitidos (separados por coma) para core/middleware/cors.ts
ALLOWED_ORIGINS="http://localhost:3000"

# WebAuthn (biometría en Payday) - features/payday/lib/webauthn-config.ts
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_ORIGIN="http://localhost:3000"

# ========================================
# OPCIONALES
# ========================================
# Google Analytics (lib/analytics.ts)
# NEXT_PUBLIC_GA_ID="G-XXXXXXX"
# URL de la landing externa (si difiere de la app)
# NEXT_PUBLIC_LANDING_URL="https://plentypay.com"
# Nivel de logs del logger de servicios (lib/services/logger.service.ts)
# LOG_LEVEL="info"
# Vercel AI Gateway (lib/ai/gateway.ts)
# AI_GATEWAY_API_KEY="vck_xxx"

# ========================================
# NOTAS DE SEGURIDAD
# ========================================
# 
# 🔒 IMPORTANTE:
# - NUNCA subir archivos .env a Git
# - NUNCA compartir credenciales en chat/email
# - Usar variables de entorno en Vercel para producción
# - Rotar credenciales periódicamente
# - Usar diferentes credenciales para dev/staging/prod
