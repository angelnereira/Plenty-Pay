{
  "name": "plentypay",
  "version": "1.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "node scripts/verify-env.js && prisma generate && next build",
    "build:vercel": "node scripts/verify-env.js && ./vercel-build.sh",
    "analyze": "ANALYZE=true npm run build",
    "build:simple": "prisma generate && next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest",
    "test:integration": "jest __tests__/integration/",
    "test:db": "jest -c jest.integration.config.js",
    "test:db:setup": "prisma generate && prisma db push --skip-generate --accept-data-loss",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:ui": "playwright test --ui",
    "lint:fix": "next lint --fix",
    "setup": "node scripts/setup.js",
    "check-config": "node scripts/check-config.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "admin:reset": "tsx scripts/reset-super-admin.ts",
    "admin:check": "tsx scripts/check-user.ts",
    "neon:auth": "neonctl auth",
    "neon:projects": "neonctl projects list",
    "neon:branches": "neonctl branches list",
    "neon:info": "node scripts/diagnose-neon.js",
    "commitlint": "commitlint --from=HEAD~1",
    "lint": "next lint || true",
    "redis:test": "tsx scripts/test-redis-upstash.ts",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "descriptor:render": "node scripts/change-descriptor.mjs render --base origin/Development/preview --head HEAD",
    "descriptor:validate": "node scripts/change-descriptor.mjs validate --body"
  },
