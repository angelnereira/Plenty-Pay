# ========================================
# PlentyPay - Variables de Entorno DESARROLLO/PREVIEW TEMPLATE
# ========================================
#
# Template del ambiente unificado de desarrollo y pruebas
# (rama Git: Development/preview | rama Neon: preview/Development/preview,
# hija Copy-on-Write de production). Trabaja de forma aislada sin
# afectar la base de datos productiva.
#
# INSTRUCCIONES:
#   1. Crea la rama Neon hija ejecutando:
#        ./scripts/setup-neon-child-branch.sh <nombre-rama-neon>
#      (ese script genera automáticamente .env.staging con la URL correcta)
#   2. O bien, copia este template manualmente:
#        cp env.staging.template .env.staging
#      y reemplaza <STAGING_*> con los valores que devuelve Neon.
#   3. NUNCA hagas commit de .env.staging (.env* ya está en .gitignore).
# ========================================

# ========================================
# DATABASE - Neon PostgreSQL (rama hija de production)
# ========================================
# IMPORTANTE: este endpoint NO debe coincidir con el de producción.
#   Producción (NO usar aquí): <PROD_ENDPOINT_ID>-pooler
#   Staging compartido:        <STAGING_SHARED_ENDPOINT_ID>-pooler
#   Tu rama hija dedicada:     ep-<STAGING_ENDPOINT_ID>-pooler
DATABASE_URL="postgresql://neondb_owner:<STAGING_PASSWORD>@ep-<STAGING_ENDPOINT_ID>-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ========================================
# NEXTAUTH.JS
# ========================================
# En staging usa el dominio del preview de Vercel o localhost
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="<generar-con-openssl-rand-base64-32>"

# ========================================
# APP CONFIGURATION
# ========================================
NEXT_PUBLIC_APP_NAME="PlentyPay (Staging)"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ========================================
# SUPER ADMIN (sólo para seed de la rama hija)
# ========================================
SUPER_ADMIN_EMAIL="admin+staging@plentypay.com"
SUPER_ADMIN_PASSWORD="<password-staging-seguro>"

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_EMAIL_NOTIFICATIONS="false"

# ========================================
# ENCRYPTION (clave DIFERENTE a producción)
# ========================================
ENCRYPTION_KEY="<openssl-rand-hex-32>"

# ========================================
# HKA - Facturación Electrónica
# ========================================
# ⚠️ En staging SIEMPRE usar el ambiente demo para evitar emitir
#    documentos fiscales reales contra el servicio productivo.
HKA_ENV="demo"

# ========================================
# EMAIL SERVICE - Resend (idealmente API key separada o sandbox)
# ========================================
RESEND_API_KEY="<STAGING_RESEND_API_KEY>"
EMAIL_FROM="PlentyPay Staging <staging@plentypay.com>"
ADMIN_EMAIL="admin+staging@plentypay.com"

# ========================================
# CLOUDINARY (folder dedicado a staging)
# ========================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<cloud-name>"
NEXT_PUBLIC_CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"

# ========================================
# REDIS (instancia separada o prefijo distinto)
# ========================================
REDIS_URL="redis://localhost:6379/1"

# ========================================
# MONITORING - Sentry (mismo DSN, environment distinto)
# ========================================
NEXT_PUBLIC_SENTRY_DSN="https://<public>@sentry.io/<project>"
SENTRY_ENVIRONMENT="development-preview"
SENTRY_AUTH_TOKEN="<auth-token>"

# ========================================
# PWA - VAPID
# ========================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY="<vapid-public>"
VAPID_PRIVATE_KEY="<vapid-private>"
NEXT_PUBLIC_VAPID_SUBJECT="mailto:admin+staging@plentypay.com"

# ========================================
# 🛡️ CHECKLIST DE AISLAMIENTO
# ========================================
# Antes de ejecutar la app con este .env.staging, verifica:
#   [ ] DATABASE_URL NO contiene el ID del endpoint de producción
#   [ ] HKA_ENV="demo" (nunca "prod")
#   [ ] NEXTAUTH_URL no apunta a plentypay.com
#   [ ] RESEND_API_KEY es una key dedicada o sandbox
#   [ ] ENCRYPTION_KEY es una clave diferente a producción
#
# Ejecuta: npx tsx scripts/verify-staging-isolation.ts
# ========================================
