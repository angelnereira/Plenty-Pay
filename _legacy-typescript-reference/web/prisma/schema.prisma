generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANCY & CLIENTS
// ============================================

model Client {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  ruc     String? @unique
  dv      String? // Dígito verificador
  email   String?
  phone   String?
  address String?
  website String?
  logo    String?

  // HKA Configuration
  hkaEnabled       Boolean @default(true)
  hkaTokenUser     String? // Token específico si lo tienen
  hkaTokenPassword String?
  hkaEnvironment   String? @default("demo") // demo | prod

  // Campos para XML/HKA
  rucType        String  @default("2") // 1=Natural, 2=Jurídica, 3=Extranjero
  tradeName      String? // Nombre comercial
  commercialName String? // Alias de tradeName
  branchCode     String  @default("0000")
  locationCode   String  @default("1-1-1")
  province       String  @default("PANAMA")
  district       String  @default("PANAMA")
  corregimiento  String  @default("SAN FELIPE")

  // Configuración de facturación automática
  autoSendToHKA        Boolean @default(true)
  requireApproval      Boolean @default(false)
  emailOnCertification Boolean @default(true)
  emailOnError         Boolean @default(true)
  lowFoliosThreshold   Int     @default(10)

  // Limits
  maxUsers       Int  @default(3) // Max total users for this client
  maxPosStations Int  @default(1) // Max concurrent POS stations/cashiers (each needs a user license)
  maxFolios      Int? // Límite máximo de folios (legacy, no enforced)
  maxBranches    Int  @default(1) // Sucursales totales permitidas (incluida + extras)
  extraBranches  Int  @default(0) // Sucursales adicionales contratadas sobre lo que incluye el plan

  // Invoice Numbering Sequence
  lastInvoiceNumber Int @default(999999) // Próximo será 1000000 = "0001000000"

  // Status
  isActive Boolean @default(true)

  // Module Feature Flags (all optional — accounts can have 0 modules active)
  facturacionEnabled    Boolean          @default(false)
  inventoryEnabled      Boolean          @default(false)
  posEnabled            Boolean          @default(false)
  paydayEnabled         Boolean          @default(false)
  logisticsEnabled      Boolean          @default(false)
  // Módulo de Créditos: gestión de créditos otorgados por el tenant a sus clientes.
  // v2.1 (tiered pricing): el módulo solo está disponible si SUPER_ADMIN
  // asigna un tier explícito. `creditosEnabled` controla visibilidad/gate;
  // `motorCreditTier` controla el límite de clientes con crédito otorgado.
  // Default false: tenants existentes y nuevos NO tienen el módulo hasta
  // que SUPER_ADMIN lo active y elija un tier.
  creditosEnabled       Boolean          @default(false)
  motorCreditTier       MotorCreditTier?
  apiAccessEnabled      Boolean          @default(false) // Endpoints REST + webhooks (incluido en ENTERPRISE)
  whatsappEnabled       Boolean          @default(false) // Addon WhatsApp Business — $19/mes
  premiumSupportEnabled Boolean          @default(false) // Addon Soporte Premium — $49/mes
  biEnabled             Boolean          @default(false) // Addon BI Esencial — $25/mes (dashboards de monitoreo)
  biProEnabled          Boolean          @default(false) // Addon BI Pro — $59/mes (builder + predicción + campañas; incluye Esencial)
  billingPeriod         BillingPeriod    @default(MONTHLY) // MONTHLY o YEARLY (~17% desc en plan)
  logisticsSecret       String?          @default(cuid()) // Secret for HMAC QR tokens

  // Soft-cap mensual de facturas: timestamps del último aviso enviado por
  // umbral. Se comparan contra el primer día del mes en curso para no
  // spammear al cliente. Reseteo natural al cambiar de mes.
  lastInvoiceCapWarning80At  DateTime?
  lastInvoiceCapWarning100At DateTime?

  // Inventory Configuration
  inventoryValuationMethod String  @default("WEIGHTED_AVG") // FIFO, WEIGHTED_AVG
  defaultLeadTimeDays      Int     @default(7)
  lowStockAlertEnabled     Boolean @default(true)
  autoReorderEnabled       Boolean @default(false)

  // Approval Status for new registrations
  approvalStatus String    @default("PENDING") // PENDING, APPROVED, PARTIAL, REJECTED
  demoStartDate  DateTime? // When demo period started
  demoEndDate    DateTime? // When demo period ends (14 days)
  pendingModules String[]  @default([]) // Modules requested during registration

  // Plan/Subscription
  planType String @default("START") // v2: START, BUSINESS, ENTERPRISE

  suspendedAt   DateTime?
  suspendReason String?
  deletedAt     DateTime? // Soft delete timestamp for delta sync

  // Metadata
  metadata Json? // JSON nativo para PostgreSQL

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users           User[]
  folios          FolioAssignment[]
  invoices        Invoice[]
  apiKeys         ApiKey[]
  systemConfigs   SystemConfig[]
  customers       Customer[]
  apiLogs         ApiLog[]
  errorLogs       ErrorLog[]
  products        Product[]
  paydayEmployees PaydayEmployee[]
  paydayConfig    PaydayConfig?
  payrollRuns     PaydayPayrollRun[]
  upgradeRequests UpgradeRequest[]
  workShifts      WorkShift[]
  workGroups      WorkGroup[]

  // Purchasing Relations
  suppliers            Supplier[]
  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  goodsReceipts        GoodsReceipt[]

  // Logistics Relations
  deliveryOrders DeliveryOrder[]
  carriers       Carrier[]
  drivers        Driver[]

  // Team Roles & Members
  teamRoles   TeamRole[]
  teamMembers TeamMember[]

  // Motor de Entidades & Ledger Financiero
  motorAssignments      ClientModuleAssignment[]
  motorUserAccess       MotorUserAccess[]
  motorEntities         MotorEntity[]
  motorFieldDefinitions MotorEntityFieldDefinition[]
  motorRelations        MotorEntityRelation[]
  motorLedgerEntries    MotorLedgerEntry[]

  // PlentyPay Payment Core + Ledger (ver services/wallet-ledger y services/payments-orchestrator)
  wallets            Wallet[]
  paymentIntents     PaymentIntent[]
  payments           Payment[]
  feePolicies        FeePolicy[]
  paymentTerminals   PaymentTerminal[]
  ledgerAccounts     LedgerAccount[]
  ledgerTransactions LedgerTransaction[]
  settlementBatches  SettlementBatch[]

  // BI (Business Intelligence)
  biAlerts     BIAlert[]
  biDashboards BIDashboard[]
  biSegments   BISavedSegment[]
  biCampaigns  BICampaign[]
  biForecasts  BIForecast[]

  @@index([slug])
  @@index([ruc])
  @@index([isActive])
  @@map("clients")
}

// ============================================
// AUTHENTICATION & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  password      String // bcrypt hashed
  name          String
  phone         String?
  image         String?
  ruc           String?
  dv            String?

  // Multi-tenant
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Role
  role UserRole @default(CLIENT)

  // Preferences
  emailNotifications Boolean            @default(true)
  language           String             @default("es")
  timezone           String             @default("America/Panama")
  checkoutPreference CheckoutPreference @default(ALWAYS_DGI)
  checkoutThreshold  Decimal            @default(20.00) @db.Decimal(10, 2)

  // Status
  isActive    Boolean    @default(true)
  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  lastLoginIp String?

  // Password reset tracking
  passwordChangedAt DateTime?

  // Metadata
  metadata Json? // JSON nativo para PostgreSQL

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  invoices            Invoice[]
  sessions            Session[]
  accounts            Account[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  apiLogs             ApiLog[]
  errorLogs           ErrorLog[]
  monitors            Monitor[]
  collections         Collection[]
  environments        Environment[]
  hkaCredentials      HKACredential[]
  pushSubscriptions   PushSubscription[]
  supportTickets      SupportTicket[]
  supportMessages     SupportMessage[]
  posSessions         PosSession[]
  upgradeRequests     UpgradeRequest[]
  teamMemberships     TeamMember[]
  securityTokens      SecurityToken[]
  passwordResetTokens PasswordResetToken[]
  motorUserAccess     MotorUserAccess?

  @@index([clientId])
  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN // Personal interno de la plataforma (devs/ops)
  CLIENT // Usuarios normales del sistema
}

enum CheckoutPreference {
  ALWAYS_DGI
  INTERNAL_ONLY
  ASK_ALWAYS
  AUTO_THRESHOLD
}

// ============================================
// POS SESSIONS - Concurrent Station Management
// ============================================

model PosSession {
  id           String    @id @default(cuid())
  clientId     String
  userId       String
  stationName  String // e.g., "Caja 1", "Caja Principal"
  status       String    @default("ACTIVE") // ACTIVE, CLOSED, TIMEOUT
  startedAt    DateTime  @default(now())
  lastActivity DateTime  @default(now())
  endedAt      DateTime?

  // Optional metadata
  ipAddress  String?
  deviceInfo String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([userId])
  @@index([lastActivity])
  @@map("pos_sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model HKACredential {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment   HKAEnvironment @default(DEMO)
  tokenUser     String
  tokenPassword String         @db.Text
  isActive      Boolean        @default(true)
  lastUsedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, environment])
  @@index([userId, environment])
  @@map("hka_credentials")
}

// ============================================
// FOLIO MANAGEMENT
// ============================================

model FolioPool {
  id          String @id @default(cuid())
  // Identificación
  batchNumber String @unique
  provider    String @default("HKA")

  // Cantidades
  totalFolios     Int
  availableFolios Int
  assignedFolios  Int @default(0)
  consumedFolios  Int @default(0)

  // Información de compra
  purchaseDate     DateTime @default(now())
  purchaseAmount   Decimal  @db.Decimal(12, 2)
  hkaInvoiceNumber String?

  // Rango de folios
  folioStart String?
  folioEnd   String?

  // Status
  isActive  Boolean   @default(true)
  expiresAt DateTime?

  // Metadata
  metadata Json? // JSON nativo para PostgreSQL

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignments FolioAssignment[]

  @@index([isActive])
  @@index([batchNumber])
  @@index([expiresAt])
  @@map("folio_pools")
}

model FolioAssignment {
  id String @id @default(cuid())

  // Pool & Client
  folioPoolId String
  folioPool   FolioPool @relation(fields: [folioPoolId], references: [id], onDelete: Restrict)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Cantidades
  assignedAmount Int
  consumedAmount Int @default(0)

  // Alertas
  alertThreshold Int       @default(10) // Porcentaje
  alertSent      Boolean   @default(false)
  lastAlertAt    DateTime?

  // Timestamps
  assignedAt DateTime  @default(now())
  expiresAt  DateTime?

  // Notas
  notes      String? @db.Text
  assignedBy String? // User ID que asignó

  @@unique([folioPoolId, clientId])
  @@index([clientId])
  @@index([folioPoolId])
  @@map("folio_assignments")
}

model FolioConsumption {
  id String @id @default(cuid())

  // Referencias
  assignmentId String
  invoiceId    String  @unique
  invoice      Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Metadata
  consumedAt  DateTime @default(now())
  folioNumber String?

  @@index([assignmentId])
  @@index([invoiceId])
  @@index([consumedAt])
  @@map("folio_consumptions")
}

// ============================================
// INVOICES & BILLING
// ============================================

model Invoice {
  id String @id @default(cuid())

  // Multi-tenant
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Creator
  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  // Idempotency
  clientReferenceId String @unique

  // RELACIÓN CUSTOMER
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Datos del Emisor (snapshot)
  issuerRuc     String
  issuerDv      String
  issuerName    String
  issuerAddress String
  issuerEmail   String
  issuerPhone   String?

  // Datos del Receptor
  receiverType    ReceiverType @default(CONTRIBUTOR)
  receiverRuc     String?
  receiverDv      String?
  receiverName    String
  receiverEmail   String?
  receiverPhone   String?
  receiverAddress String?

  // Documento
  documentType          DocumentType @default(FACTURA)
  invoiceNumber         String? // Asignado por HKA
  cufe                  String?      @unique
  cufeLocal             String? // CUFE pre-generado localmente antes del envío a HKA
  cafe                  String? // Código de Autorización FE
  numeroDocumentoFiscal String? // Ej: 001-0000-01-12345678
  qrCode                String?      @db.Text // QR en Base64 (imagen)
  qrUrl                 String?      @db.Text // URL del QR para consulta en DGI

  // Campos adicionales para XML/HKA
  pointOfSale   String    @default("001")
  securityCode  String? // Código de seguridad (random 8-9 dígitos)
  deliveryDate  DateTime?
  paymentMethod String    @default("CASH") // CASH, CHECK, TRANSFER, CREDIT_CARD, DEBIT_CARD
  paymentTerm   String    @default("CASH") // CASH (Contado), CREDIT (Crédito)
  xmlContent    String?   @db.Text // XML generado

  // Montos
  subtotal              Decimal @db.Decimal(12, 2)
  discount              Decimal @default(0) @db.Decimal(12, 2)
  subtotalAfterDiscount Decimal @db.Decimal(12, 2)
  itbms                 Decimal @db.Decimal(12, 2) // Impuesto
  total                 Decimal @db.Decimal(12, 2)
  currency              String  @default("PAB")

  // Fechas
  issueDate DateTime  @default(now())
  dueDate   DateTime?

  // Notas
  notes         String? @db.Text
  internalNotes String? @db.Text

  // --- Notas de Crédito/Débito: Referencia a documento original ---
  noteSubtype         NoteSubtype? // REFERENCED (04/05) o GENERIC (06/07)
  referencedInvoiceId String? // FK a la factura original (para tipo 04/05)
  referencedInvoice   Invoice?     @relation("CreditDebitNotes", fields: [referencedInvoiceId], references: [id])
  creditDebitNotes    Invoice[]    @relation("CreditDebitNotes")

  // Datos del emisor original referenciado (gDFRef / B60)
  refEmitterType  String? // B6011 - Tipo contribuyente emisor original (1=Natural, 2=Jurídica)
  refEmitterRuc   String? // B6012 - RUC emisor original
  refEmitterDv    String? // B6013 - DV emisor original
  refEmitterName  String? // B602 - Razón social emisor original
  refDocumentDate DateTime? // B603 - Fecha exacta del doc original
  refDocumentType String? // B604 - Tipo doc original (01, 02, 03...)
  refCufe         String? // B606 - CUFE del doc original (66 chars)

  // Exportación (gFExp) — Solo para tipoDocumento 03 (Factura de Exportación)
  exportIncoterm      String? // INCOTERMS (Tabla 32 DGI) ej: "FOB", "CIF"
  exportCurrency      String? // Moneda ISO 4217 ej: "USD", "EUR"
  exportCurrencyDesc  String? // Descripción si moneda="ZZZ"
  exportExchangeRate  Decimal? @db.Decimal(11, 4) // Tasa de cambio si moneda ≠ USD
  exportForeignAmount Decimal? @db.Decimal(20, 4) // Monto total en moneda extranjera
  exportPort          String? // Puerto de embarque

  // Alerta de antigüedad DGI
  dgiNotificationCode String? // Código "N" de notificación DGI (>180 días)

  // Estado
  status          InvoiceStatus @default(DRAFT)
  hkaStatus       String?
  hkaMessage      String?       @db.Text
  rejectionReason String?       @db.Text
  hkaCode         String? // Código de respuesta HKA

  // HKA Integration - Campos adicionales
  hkaProtocol        String?   @unique // Número de protocolo HKA (para v1)
  protocoloSeguridad String? // Protocolo de seguridad HKA v2
  hkaProtocolDate    DateTime?
  pdfBase64          String?   @db.Text // PDF firmado en base64
  hkaResponseCode    String? // Código numérico de respuesta HKA
  hkaResponseMessage String?   @db.Text // Mensaje de respuesta detallado
  hkaResponseData    Json? // Datos adicionales en JSON
  hkaLastAttempt     DateTime?
  hkaAttempts        Int       @default(0)
  emittedAt          DateTime? // Fecha de emisión exitosa

  // Control de descarga de archivos
  pdfDescargado Boolean @default(false) // Indica si el PDF fue descargado
  xmlDescargado Boolean @default(false) // Indica si el XML fue descargado

  // Storage
  xmlUrl String?
  pdfUrl String?
  rawXml String? @db.Text

  // Phase tracking for 8-phase processing workflow
  currentPhase     Int?      @default(0) // 0=Init, 1-8=Processing phases
  phaseHistory     Json? // Array of {phase, status, timestamp, attempt}
  phaseErrors      Json? // Errors by phase {phase: error}
  lastPhaseAttempt DateTime? // Last phase execution timestamp

  // B2C/Mostrador — Fecha límite para autorización DGI posterior
  // tipoEmision=03: fin del día hábil siguiente a fechaEmision
  // tipoEmision=04: fechaEmision + 72 horas exactas
  fechaLimitePosterior DateTime?

  // Contingencia (campos DGI B04/B05) — obligatorio cuando tipoEmisionOverride es '02' o '04'.
  // Persiste el modo de emisión determinado offline para que el worker lo use aunque la
  // contingencia ya esté desactivada cuando llega la sincronización.
  tipoEmisionOverride     String? // '01'|'02'|'03'|'04' — anula resolución dinámica del config
  fechaInicioContingencia DateTime? // B04: momento exacto en que inició la caída
  motivoContingencia      String?   @db.Text // B05: texto libre 15-250 chars

  // Anulación
  isCancelled        Boolean   @default(false)
  cancelledAt        DateTime?
  cancellationReason String?   @db.Text
  cancellationCufe   String?

  // Retry logic
  retryCount  Int       @default(0)
  maxRetries  Int       @default(3)
  nextRetryAt DateTime?
  deletedAt   DateTime? // Soft delete timestamp for delta sync

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  queuedAt    DateTime?
  sentAt      DateTime?
  certifiedAt DateTime?

  // Relations
  items            InvoiceItem[]
  logs             InvoiceLog[]
  folioConsumption FolioConsumption?
  emailDeliveries  EmailDelivery[]

  @@index([clientId])
  @@index([createdBy])
  @@index([status])
  @@index([cufe])
  @@index([cafe])
  @@index([issuerRuc])
  @@index([receiverRuc])
  @@index([createdAt])
  @@index([issueDate])
  @@index([documentType])
  @@index([currentPhase])
  @@index([lastPhaseAttempt])
  @@index([referencedInvoiceId])
  // Índices compuestos para queries optimizadas
  @@index([clientId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([clientId, status, createdAt(sort: Desc)])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT // Borrador
  INTERNAL // Venta interna - registrada sin emisión fiscal
  QUEUED // En cola
  PROCESSING // Procesando en HKA
  PENDING_DGI // Aceptado por HKA (202), pendiente de validación DGI
  EMITTED // Emitido exitosamente por HKA
  CERTIFIED // Certificado por DGI (legacy)
  REJECTED // Rechazado
  CANCELLED // Anulado
  ERROR // Error
}

enum DocumentType {
  FACTURA // 01 - Factura de operación interna
  FACTURA_IMPORTACION // 02 - Factura de importación
  FACTURA_EXPORTACION // 03 - Factura de exportación
  NOTA_CREDITO // 04 (referenciada) o 06 (genérica) según noteSubtype
  NOTA_DEBITO // 05 (referenciada) o 07 (genérica) según noteSubtype
  FACTURA_ZONA_FRANCA // 08 - Factura de Zona Franca
  REEMBOLSO // 09 - Reembolso
  FACTURA_EXTRANJERA // 10 - Factura por operaciones de terceros/extranjera
}

enum NoteSubtype {
  REFERENCED // Tipo 04/05 — referencia a FE específica (requiere gDFRef)
  GENERIC // Tipo 06/07 — genérica sin referencia (gDFRef prohibido)
}

enum ReceiverType {
  CONTRIBUTOR // 01 - Contribuyente con RUC
  FINAL_CONSUMER // 02 - Consumidor final
  GOVERNMENT // 03 - Gobierno
  FOREIGN // 04 - Extranjero
}

enum HKAEnvironment {
  DEMO
  PROD
}

enum EmailStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

// ============================================
// CUSTOMERS (CLIENTES)
// ============================================

model Customer {
  id String @id @default(cuid())

  // Multi-tenant
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Datos básicos
  ruc     String
  dv      String
  name    String
  email   String?
  phone   String?
  address String

  // Ubicación
  locationCode  String?
  province      String?
  district      String?
  corregimiento String?
  countryCode   String  @default("PA")

  // Tipo de cliente
  clientType String @default("01") // 01=Contribuyente, 02=Consumidor Final, 03=Gobierno, 04=Extranjero
  rucType    String @default("2") // 1=Natural, 2=Jurídica, 3=Extranjero

  // Campos especiales para Gobierno (tipoClienteFE=03)
  codigoCPBS String? // Código CPBS para clientes gubernamentales

  // Status
  isActive  Boolean   @default(true)
  deletedAt DateTime? // Soft delete timestamp for delta sync

  // Relación con Invoice
  invoices Invoice[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, ruc, dv])
  @@index([clientId])
  @@index([clientId, isActive])
  @@index([ruc])
  @@map("customers")
}

model InvoiceItem {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Referencia opcional al producto del inventario
  // Permite descontar stock automáticamente al emitir facturas desde el módulo de facturación
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Order
  lineNumber Int

  // Product/Service
  code        String
  description String @db.Text

  // Quantities
  quantity  Decimal @db.Decimal(12, 4)
  unitPrice Decimal @db.Decimal(12, 2)
  unit      String  @default("UND")

  // Discount
  discount        Decimal  @default(0) @db.Decimal(12, 2)
  discountRate    Decimal  @default(0) @db.Decimal(5, 2)
  discountedPrice Decimal? @db.Decimal(12, 2) // Precio unitario con descuento

  // Tax (ITBMS)
  taxRate   Decimal @default(7) @db.Decimal(5, 2)
  taxCode   String  @default("01") // Código ITBMS
  taxAmount Decimal @db.Decimal(12, 2)

  // OTI (Otros Tributos e Impuestos) - Nuevo soporte HKA
  otiCode   String? // Código OTI según catálogo HKA (Ej: "A1" ISC)
  otiAmount Decimal? @db.Decimal(12, 2) // Monto OTI calculado

  // Totals
  subtotal Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  // Additional info
  cpbsCode String? // Código CPBS (Clasificación)
  cpbsUnit String?

  @@index([invoiceId])
  @@index([invoiceId, lineNumber])
  @@map("invoice_items")
}

model InvoiceLog {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Log
  action   LogAction
  message  String    @db.Text
  metadata Json?

  // User (opcional)
  userId    String?
  userEmail String?
  userIp    String?

  // Timestamp
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([createdAt])
  @@index([action])
  @@map("invoice_logs")
}

enum LogAction {
  CREATED
  UPDATED
  QUEUED
  SENT
  PROCESSING
  CERTIFIED
  REJECTED
  ERROR
  CANCELLED
  DOWNLOADED_XML
  DOWNLOADED_PDF
  EMAIL_SENT
  RETRIED
  MANUAL_INTERVENTION
}

// ============================================
// EMAIL DELIVERY
// ============================================

model EmailDelivery {
  id String @id @default(cuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  recipientEmail String
  hkaTrackingId  String?

  status EmailStatus

  sentAt      DateTime?
  deliveredAt DateTime?

  includePDF    Boolean @default(true)
  includeXML    Boolean @default(true)
  customMessage String? @db.Text

  retryCount Int     @default(0)
  lastError  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@index([hkaTrackingId])
  @@map("email_deliveries")
}

// ============================================
// API KEYS & INTEGRATIONS
// ============================================

model ApiKey {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Key
  name   String
  key    String @unique
  prefix String // Primeros 8 caracteres

  // Permissions
  permissions String // JSON como string para SQLite

  // Rate limiting
  rateLimit       Int @default(100) // por minuto
  rateLimitWindow Int @default(60) // segundos

  // Status
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  expiresAt  DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([key])
  @@index([prefix])
  @@map("api_keys")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Content
  type    NotificationType
  title   String
  message String           @db.Text
  link    String?

  // Metadata
  metadata Json? // JSON nativo para PostgreSQL

  // Status
  read   Boolean   @default(false)
  readAt DateTime?

  // Timestamp
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  INVOICE_CERTIFIED
  INVOICE_REJECTED
  INVOICE_ERROR
  FOLIOS_LOW
  FOLIOS_DEPLETED
  FOLIOS_ASSIGNED
  SYSTEM_ALERT
  PAYMENT_REQUIRED
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id String @id @default(cuid())

  // User
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?

  // Action
  action   String
  entity   String // Invoice, User, Client, etc.
  entityId String

  // Details
  changes String? // JSON como string para SQLite

  // Context
  ip        String?
  userAgent String?

  // Timestamp
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  id String @id @default(cuid())

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  key         String
  value       String   @db.Text // JSON como string
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@unique([clientId, key])
  @@index([key])
  @@index([clientId])
  @@map("system_configs")
}

// ============================================
// API CALL LOGS
// ============================================

model ApiLog {
  id String @id @default(cuid())

  // Request Details
  method   String // GET, POST, PUT, DELETE, etc.
  path     String
  endpoint String // Full endpoint
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Request Data
  requestHeaders Json? // Headers como JSON
  requestBody    String? @db.Text // Body como string (puede ser grande)
  requestQuery   Json? // Query params

  // Response Data
  statusCode      Int
  responseBody    String? @db.Text // Response como string
  responseHeaders Json? // Response headers
  success         Boolean
  errorMessage    String? @db.Text

  // Technical Details
  ip           String?
  userAgent    String?
  duration     Int? // Duración en ms
  responseSize Int? // Tamaño de respuesta en bytes

  // Context
  apiName   String? // HKA, Internal, External
  apiMethod String? // Método específico del API (ConsultarFolios, etc.)

  // Timestamp
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([endpoint])
  @@index([statusCode])
  @@index([success])
  @@index([apiName])
  @@index([createdAt])
  @@map("api_logs")
}

// ============================================
// ERROR LOGGING SYSTEM
// ============================================

model ErrorLog {
  id String @id @default(cuid())

  // Request Context
  requestId String? // Correlation ID para seguir errores
  method    String? // HTTP method
  path      String? // Request path
  endpoint  String? // Full endpoint

  // User Context
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?

  // Organization Context
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Error Details
  errorType    String // Error class name
  errorMessage String  @db.Text
  errorCode    String? // HTTP status code, prisma code, etc
  errorStack   String? @db.Text

  // Request/Response Data (sanitized)
  requestBody    String? @db.Text
  requestQuery   Json?
  requestHeaders Json?
  responseBody   String? @db.Text

  // Technical Context
  ip        String?
  userAgent String?
  duration  Int? // Time until error in ms

  // Environment
  environment String? // production, staging, development
  hostname    String? // Server hostname
  version     String? // App version/git commit

  // Sentry Integration
  sentryEventId String? @unique // Link to Sentry event
  sentryUrl     String? // Direct link to Sentry issue

  // Resolution
  resolved     Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedBy   String?
  resolvedNote String?   @db.Text

  // Metadata
  metadata Json? // Additional context as JSON

  // Timestamps
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([endpoint])
  @@index([errorType])
  @@index([errorCode])
  @@index([resolved])
  @@index([createdAt])
  @@index([requestId])
  @@index([sentryEventId])
  @@map("error_logs")
}

// ============================================
// MONITORING SYSTEM
// ============================================

model Monitor {
  id String @id @default(cuid())

  // Basic info
  name        String
  description String? @db.Text

  // Collection reference
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  // Schedule
  schedule Json // Cron expression and settings
  enabled  Boolean @default(true)

  // Multi-region
  regions Json? // Array of regions

  // Notification settings
  notifications Json? // Notification config

  // Metadata
  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  runs MonitorRun[]

  @@index([createdBy])
  @@index([enabled])
  @@map("monitors")
}

model MonitorRun {
  id String @id @default(cuid())

  // Run info
  monitorId String
  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  status String // RUNNING | SUCCESS | FAILED | TIMEOUT
  region String?

  // Timing
  startedAt  DateTime
  finishedAt DateTime?
  duration   Int? // milliseconds

  triggeredBy String? // user_id or 'schedule'

  // Results
  totalRequests Int @default(0)
  passedTests   Int @default(0)
  failedTests   Int @default(0)

  error String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  requests MonitorRunRequest[]

  @@index([monitorId])
  @@index([status])
  @@index([startedAt])
  @@map("monitor_runs")
}

model MonitorRunRequest {
  id String @id @default(cuid())

  runId String
  run   MonitorRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  requestName String
  method      String
  url         String

  statusCode   Int?
  responseTime Int? // milliseconds
  responseSize Int? // bytes

  passedTests Int @default(0)
  failedTests Int @default(0)

  error     String? @db.Text
  errorCode String?

  // Request/Response (sensitive data)
  requestBody     String? @db.Text
  responseBody    String? @db.Text
  requestHeaders  Json?
  responseHeaders Json?

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  tests MonitorRunTest[]

  @@index([runId])
  @@map("monitor_run_requests")
}

model MonitorRunTest {
  id String @id @default(cuid())

  requestId String
  request   MonitorRunRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  testName String
  passed   Boolean
  message  String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())

  @@index([requestId])
  @@index([passed])
  @@map("monitor_run_tests")
}

model Collection {
  id String @id @default(cuid())

  name       String
  definition Json? // Collection definition (JSON format)

  // Metadata
  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  monitors Monitor[]

  @@index([createdBy])
  @@map("collections")
}

model Environment {
  id String @id @default(cuid())

  name String

  // Variables (encrypted at rest)
  variables Json? // { [key: string]: string }

  // Scope
  scope String @default("collection") // global | collection | monitor

  // Metadata
  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
  @@index([scope])
  @@map("environments")
}

// ============================================
// HKA CATALOGS - Tablas de referencia
// ============================================

// Ubicaciones de Panamá (Provincia-Distrito-Corregimiento)
model HKALocation {
  id            String @id @default(cuid())
  code          String @unique // Formato: "8-8-1"
  provincia     String
  distrito      String
  corregimiento String
  fullName      String // "PANAMA-PANAMA-SAN FELIPE"

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([provincia])
  @@index([provincia, distrito])
  @@map("hka_locations")
}

// Países según ISO 3166
model HKACountry {
  id     String @id @default(cuid())
  code   String @unique // ISO 3166-1 alpha-2: "PA", "US", etc.
  name   String // Nombre en inglés
  nameEs String // Nombre en español

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@map("hka_countries")
}

// Categorías CPBS (Codificación Panameña de Bienes y Servicios)
model HKACPBSCategory {
  id          String @id @default(cuid())
  segment     String // Código de 2 dígitos: "10", "11", etc.
  family      String // Código de 4 dígitos: "1010", "1011", etc.
  segmentName String // Nombre del segmento
  familyName  String // Nombre de la familia

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([segment, family])
  @@index([segment])
  @@index([family])
  @@map("hka_cpbs_categories")
}

// ============================================
// INVENTORY & PRODUCTS
// ============================================

model Product {
  id String @id @default(cuid())

  // Multi-tenant
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Basic Info
  sku         String?
  barcode     String?
  name        String
  brand       String?
  description String? @db.Text
  category    String?
  image       String?

  // Specs
  weight     String?
  size       String?
  dimensions String? // tamaño/talla
  color      String?
  material   String?
  unitType   String  @default("UND") // UND, CAJA, LOTE, etc.

  // Inventory logic
  currentStock Decimal @default(0) @db.Decimal(12, 4)
  minStock     Decimal @default(0) @db.Decimal(12, 4)

  // Pricing & Taxes
  purchasePrice Decimal @default(0) @db.Decimal(12, 2)
  salePrice     Decimal @default(0) @db.Decimal(12, 2)
  taxRate       Decimal @default(7) @db.Decimal(5, 2)
  taxCode       String  @default("01") // Código ITBMS

  // HKA / DGI
  cpbsCode String? // Código CPBS (Clasificación DGI)
  cpbsUnit String? // Unidad de medida CPBS (ej: und, Mes, Hora)

  // Metadata
  originCountry String?
  isActive      Boolean   @default(true)
  metadata      Json?
  deletedAt     DateTime?

  // ABC Classification
  abcClass        String    @default("C") // A, B, C
  abcClassifiedAt DateTime?

  // Reorder Point & Safety Stock
  reorderPoint Decimal @default(0) @db.Decimal(12, 4)
  safetyStock  Decimal @default(0) @db.Decimal(12, 4)
  maxStock     Decimal @default(0) @db.Decimal(12, 4)
  eoqQuantity  Decimal @default(0) @db.Decimal(12, 4) // Economic Order Quantity

  // Demand Statistics (for forecasting)
  avgDailyDemand    Decimal   @default(0) @db.Decimal(12, 4)
  demandVariability Decimal   @default(0) @db.Decimal(5, 2) // Coefficient of variation
  lastDemandUpdate  DateTime?

  // ACID Compliance - Optimistic Concurrency Control
  version Int @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions     InventoryTransaction[]
  lots             InventoryLot[]
  supplierProducts SupplierProduct[]
  stockMovements   StockMovement[]
  cartReservations CartReservation[]
  invoiceItems     InvoiceItem[] // Ítems de facturas que referencian este producto

  @@unique([clientId, sku])
  @@unique([clientId, barcode])
  @@index([clientId])
  @@index([sku])
  @@index([barcode])
  @@index([name])
  @@index([version])
  @@map("products")
}

model InventoryLot {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Lot Details
  batchNumber     String?
  quantity        Decimal @db.Decimal(12, 4)
  initialQuantity Decimal @db.Decimal(12, 4)

  // Pricing at entry
  purchasePrice Decimal @default(0) @db.Decimal(12, 2)
  salePrice     Decimal @default(0) @db.Decimal(12, 2)

  // Dates
  expiryDate DateTime?
  entryDate  DateTime  @default(now())

  // Origin
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  originCountry String?

  // Goods Receipt reference
  goodsReceiptItemId String?

  // Valuation (for FIFO tracking)
  unitCost  Decimal @default(0) @db.Decimal(12, 2) // Cost per unit at time of receipt
  totalCost Decimal @default(0) @db.Decimal(12, 2) // Total cost of lot

  // Status
  isActive Boolean @default(true)
  notes    String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([batchNumber])
  @@index([expiryDate])
  @@index([supplierId])
  @@map("inventory_lots")
}

model InventoryTransaction {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     InventoryTransactionType
  quantity Decimal                  @db.Decimal(12, 4)

  // References
  invoiceId String?
  lotId     String?

  // Details
  reason    String?
  reference String? // e.g., Invoice #, Batch #

  // Auth
  userId String?

  // Metadata
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([type])
  @@index([invoiceId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

enum InventoryTransactionType {
  ENTRY // Entrada (Compra, Devolución)
  EXIT // Salida (Venta, Pérdida)
  ADJUST // Ajuste manual
}

// ============================================
// SUPPLIERS & PROCUREMENT
// ============================================

model Supplier {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Basic Info
  code      String // Internal supplier code
  name      String
  tradeName String? // Commercial name
  ruc       String?
  dv        String?

  // Contact
  email        String?
  phone        String?
  address      String? @db.Text
  city         String?
  country      String  @default("PA")
  contactName  String?
  contactPhone String?
  contactEmail String?
  website      String?

  // Payment Terms
  paymentTerms String? // NET30, NET60, CASH, etc.
  creditLimit  Decimal? @db.Decimal(12, 2)
  currency     String   @default("USD")
  bankAccount  String?
  bankName     String?

  // Lead Times
  defaultLeadTimeDays Int @default(7)

  // Classification & Status
  category String? // Raw Materials, Services, Equipment, etc.
  tier     String  @default("STANDARD") // STRATEGIC, PREFERRED, STANDARD, PROBATION
  isActive Boolean @default(true)

  // Certifications (ISO compliance)
  certifications String[] @default([])

  // Audit
  notes     String?   @db.Text
  metadata  Json?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  purchaseOrders   PurchaseOrder[]
  evaluations      SupplierEvaluation[]
  supplierProducts SupplierProduct[]
  inventoryLots    InventoryLot[]

  @@unique([clientId, code])
  @@unique([clientId, ruc, dv])
  @@index([clientId])
  @@index([name])
  @@index([tier])
  @@map("suppliers")
}

model SupplierProduct {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Pricing
  unitPrice    Decimal  @db.Decimal(12, 2)
  currency     String   @default("USD")
  minOrderQty  Decimal? @db.Decimal(12, 4)
  leadTimeDays Int?

  // Supplier's product code
  supplierSku String?

  isPrimary Boolean @default(false) // Primary supplier for this product
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([productId])
  @@map("supplier_products")
}

model SupplierEvaluation {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  // Evaluation Period
  periodStart DateTime
  periodEnd   DateTime

  // KPIs (0-100 scale)
  onTimeDeliveryRate   Decimal @db.Decimal(5, 2) // % of orders on time
  qualityRate          Decimal @db.Decimal(5, 2) // % without defects
  responseTimeScore    Decimal @db.Decimal(5, 2) // 0-100 based on responsiveness
  priceCompetitiveness Decimal @db.Decimal(5, 2) // Market comparison

  overallScore Decimal @db.Decimal(5, 2) // Calculated weighted average

  // Metrics
  totalOrders    Int @default(0)
  onTimeOrders   Int @default(0)
  lateOrders     Int @default(0)
  defectiveItems Int @default(0)
  totalItems     Int @default(0)

  notes       String?  @db.Text
  evaluatedBy String?
  createdAt   DateTime @default(now())

  @@index([supplierId])
  @@index([periodEnd])
  @@map("supplier_evaluations")
}

// ============================================
// PURCHASE REQUISITIONS
// ============================================

model PurchaseRequisition {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Document
  requisitionNumber String
  requestedBy       String // User ID
  requestedAt       DateTime  @default(now())
  requiredDate      DateTime?

  // Justification
  reason     String  @db.Text
  department String?
  costCenter String?
  budgetCode String?

  // Status Workflow
  status          String    @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REJECTED, CONVERTED
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?   @db.Text

  // Totals
  estimatedTotal Decimal @db.Decimal(12, 2)
  currency       String  @default("USD")

  notes     String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items          PurchaseRequisitionItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([clientId, requisitionNumber])
  @@index([clientId])
  @@index([status])
  @@index([requestedBy])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id            String              @id @default(cuid())
  requisitionId String
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  productId          String?
  description        String
  quantity           Decimal @db.Decimal(12, 4)
  unit               String  @default("UND")
  estimatedUnitPrice Decimal @db.Decimal(12, 2)
  estimatedTotal     Decimal @db.Decimal(12, 2)

  suggestedSupplierId String?
  notes               String? @db.Text

  @@index([requisitionId])
  @@map("purchase_requisition_items")
}

// ============================================
// PURCHASE ORDERS
// ============================================

model PurchaseOrder {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Document
  poNumber   String
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  // Source
  requisitionId String?
  requisition   PurchaseRequisition? @relation(fields: [requisitionId], references: [id])

  // Status Lifecycle
  // DRAFT -> SENT -> CONFIRMED -> PARTIAL_RECEIVED -> RECEIVED -> CLOSED -> CANCELLED
  status String @default("DRAFT")

  // Dates
  orderDate          DateTime  @default(now())
  expectedDate       DateTime?
  confirmedDate      DateTime?
  deliveryDate       DateTime?
  closedDate         DateTime?
  cancelledDate      DateTime?
  cancellationReason String?   @db.Text

  // Shipping
  shippingAddress String?  @db.Text
  shippingMethod  String?
  shippingCost    Decimal? @db.Decimal(12, 2)

  // Payment
  paymentTerms  String?
  paymentMethod String?
  currency      String  @default("USD")

  // Totals
  subtotal  Decimal @db.Decimal(12, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  // Audit
  createdBy     String
  approvedBy    String?
  approvedAt    DateTime?
  notes         String?   @db.Text
  internalNotes String?   @db.Text
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([clientId, poNumber])
  @@index([clientId])
  @@index([supplierId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  lineNumber  Int
  productId   String?
  description String
  unit        String  @default("UND")

  // Quantities
  quantityOrdered  Decimal @db.Decimal(12, 4)
  quantityReceived Decimal @default(0) @db.Decimal(12, 4)
  quantityPending  Decimal @db.Decimal(12, 4) // Calculated: ordered - received

  // Pricing
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  notes String? @db.Text

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ============================================
// GOODS RECEIPT (Receiving)
// ============================================

model GoodsReceipt {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  receiptNumber   String
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  // Receipt Details
  receivedDate DateTime @default(now())
  receivedBy   String

  // Documents
  deliveryNote  String? // Supplier's delivery note number
  invoiceNumber String? // Supplier's invoice if available

  // Quality Check
  inspectionStatus String    @default("PENDING") // PENDING, PASSED, FAILED, PARTIAL
  inspectedBy      String?
  inspectedAt      DateTime?
  inspectionNotes  String?   @db.Text

  // Storage
  warehouseLocation String?

  notes     String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  items GoodsReceiptItem[]

  @@unique([clientId, receiptNumber])
  @@index([clientId])
  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id             String       @id @default(cuid())
  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  poItemId  String? // Link to PurchaseOrderItem
  productId String?

  // Quantities
  quantityReceived Decimal @db.Decimal(12, 4)
  quantityAccepted Decimal @db.Decimal(12, 4)
  quantityRejected Decimal @default(0) @db.Decimal(12, 4)

  // Lot/Batch Info
  batchNumber  String?
  serialNumber String?
  expiryDate   DateTime?

  // Quality
  qualityStatus   String  @default("PENDING") // PENDING, ACCEPTED, REJECTED
  rejectionReason String? @db.Text

  // Cost
  unitCost Decimal @db.Decimal(12, 2)

  notes String? @db.Text

  @@index([goodsReceiptId])
  @@map("goods_receipt_items")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIAL_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
}

enum SupplierTier {
  STRATEGIC
  PREFERRED
  STANDARD
  PROBATION
}

// ============================================
// ADMIN BROADCASTS (System Notifications)
// ============================================

model AdminBroadcast {
  id String @id @default(cuid())

  // Content
  title   String
  message String  @db.Text
  type    String  @default("INFO") // INFO, WARNING, MAINTENANCE, FEATURE
  link    String?

