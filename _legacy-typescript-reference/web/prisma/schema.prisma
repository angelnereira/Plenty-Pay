// ============================================
// SUPPORT & TICKETING SYSTEM
// ============================================

model SupportTicket {
  id String @id @default(cuid())

  // Reporter
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Ticket Info
  subject     String
  description String?         @db.Text
  status      SupportStatus   @default(OPEN)
