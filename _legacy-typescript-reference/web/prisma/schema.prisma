// ============================================
// PAYDAY MODULE (NOMINA & TIME)
// ============================================

model PaydayConfig {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Company Settings
  commercialZone   String @default("NORMAL") // ZONA_FRANCA, CASINO, HOTEL, NORMAL
  operationalHours Json? // { start: "08:00", end: "17:00", days: [1,2,3,4,5] }

  // Payroll Settings
  payFrequency PayFrequency @default(BIWEEKLY)
  nextPayDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payday_configs")
}

model PaydayEmployee {
  id           String  @id @default(cuid())
  employeeCode String? @unique // NEW: Human-readable ID like "EMP-00001"
  clientId     String // Multi-tenancy
  client       Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Personal Info
  firstName String
  lastName  String
  cedula    String // Identificador legal
  email     String?
  phone     String?

  // Contract Info
  contractType PaydayContractType @default(INDEFINIDO)
  paymentMode  PaydayPaymentMode  @default(TIEMPO)
  baseSalary   Decimal            @default(0) @db.Decimal(10, 2) // Monthly or Hourly based on paymentMode
  hourlyRate   Decimal?           @db.Decimal(10, 2)

  // Biometrics & Access (Hashed/Tokenized - Ley 81)
  faceIdHash     String? // Hash de vector facial (Legacy/Fallback)
  faceDescriptor Json? // Vector facial para matching (Array de floats)
  fingerprintId  String? // WebAuthn/Hash
  nfcTagId       String? // UID
  qrSecret       String? @unique // Already exists - QR for biometric access
  pinCode        String? // Encrypted PIN for simple access

  // Status
  isActive     Boolean   @default(true)
  joinedAt     DateTime  @default(now())
  terminatedAt DateTime?

  // Group & Schedule
  workGroupId String?
  workGroup   WorkGroup? @relation(fields: [workGroupId], references: [id])

  // Relations
  shifts              AttendanceRecord[]
  tasks               TaskRecord[]
  payrollItems        PayrollItem[]
  scheduleAssignments ScheduleAssignment[]
  authenticators      Authenticator[] // WebAuthn passkeys

  @@unique([clientId, cedula])
  @@index([clientId])
  @@index([nfcTagId])
  @@map("payday_employees")
}

// WebAuthn Authenticator for biometric access (fingerprint/FaceID)
model Authenticator {
  id                   String  @id @default(cuid())
  credentialID         Bytes   @unique
  credentialPublicKey  Bytes
  counter              BigInt
  credentialDeviceType String // "singleDevice" | "multiDevice"
  credentialBackedUp   Boolean
  transports           String? // JSON array of transports

  // Link to employee
  employeeId String
  employee   PaydayEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Multi-tenant isolation
  clientId String

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([clientId])
  @@map("authenticators")
}

model AttendanceRecord {
  id         String         @id @default(cuid())
  employeeId String
  employee   PaydayEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  shiftDate DateTime @default(now()) // The logical date of the shift

  // Time Logs
  checkIn    DateTime
  checkOut   DateTime?
  breakStart DateTime?
  breakEnd   DateTime?

  // Validation Metadata
  entryMethod PaydayEntryMethod // FACE, FINGER, NFC, QR, MANUAL
  exitMethod  PaydayEntryMethod?
  geoLocation Json? // { lat, lng }
  userAgent   String?
  isVerified  Boolean            @default(true)

  // Schedule Snapshot & Compliance
  workShiftId           String?
  workShift             WorkShift? @relation(fields: [workShiftId], references: [id])
  scheduledCheckIn      DateTime? // Expected time logic
  scheduledCheckOut     DateTime?
  lateMinutes           Int        @default(0)
  earlyDepartureMinutes Int        @default(0)

  // Legal Calculations (Populated by trigger/job)
  rawDurationMinutes Float @default(0)
  regularHours       Float @default(0)
  overtime25         Float @default(0) // Diurna Extra
  overtime50         Float @default(0) // Nocturna/Sunday
  overtime75         Float @default(0) // Mixed->Nocturna excess

  status ShiftStatus @default(OPEN) // OPEN, COMPLETED, REVIEW_NEEDED, APPROVED

  // Corrections
  adminNotes  String?
  correctedBy String? // User ID of admin who fixed it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([shiftDate])
  @@index([status])
  @@map("attendance_records")
}

model WorkShift {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name               String // "Matutino", "Nocturno A"
  startTime          String // "08:00"
  endTime            String // "17:00"
  breakDuration      Int    @default(60) // Minutes
  gracePeriodMinutes Int    @default(0) // Minutes before marked as late

  color String @default("#3b82f6") // UI display color

  isActive Boolean @default(true)

  // Relations
  assignments ScheduleAssignment[]
  attendance  AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
  @@map("payday_work_shifts")
}

model WorkGroup {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String // "Cajeros", "Bodega"
  description String?

  // Relations
  members     PaydayEmployee[]
  assignments ScheduleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, name])
  @@map("payday_work_groups")
}

model ScheduleAssignment {
  id String @id @default(cuid())

  // Target (Polymorphic-ish logic)
  workGroupId String?
  workGroup   WorkGroup? @relation(fields: [workGroupId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   PaydayEmployee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Assigned Shift
  workShiftId String
  workShift   WorkShift @relation(fields: [workShiftId], references: [id], onDelete: Cascade)

  // Validity
  startDate  DateTime
  endDate    DateTime? // Null = Indefinite
  daysOfWeek Int[] // [1, 2, 3, 4, 5] -> Mon-Fri

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workGroupId])
  @@index([employeeId])
  @@index([startDate, endDate])
  @@map("payday_schedule_assignments")
}

model TaskRecord {
  id         String         @id @default(cuid())
  employeeId String
  employee   PaydayEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  description String
  value       Decimal    @db.Decimal(10, 2)
  status      TaskStatus @default(PENDING) // PENDING, APPROVED, REJECTED

  completedAt DateTime  @default(now())
  approvedAt  DateTime?
  approvedBy  String?

  @@index([employeeId])
  @@map("task_records")
}

model PaydayPayrollRun {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  // Totals
  totalGross    Decimal @db.Decimal(12, 2)
  totalNet      Decimal @db.Decimal(12, 2)
  employeeCount Int

  status PayrollStatus @default(DRAFT) // DRAFT, LOCKED, PAID

  generatedAt DateTime  @default(now())
  paidAt      DateTime?

  items PayrollItem[]

  @@index([clientId])
  @@map("payday_payroll_runs")
}

model PayrollItem {
  id           String           @id @default(cuid())
  payrollRunId String
  payrollRun   PaydayPayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)

  employeeId String
  employee   PaydayEmployee @relation(fields: [employeeId], references: [id])

  // Payload snapshot
  regularPay  Decimal @default(0) @db.Decimal(10, 2)
  overtimePay Decimal @default(0) @db.Decimal(10, 2)
  bonuses     Decimal @default(0) @db.Decimal(10, 2)
  deductions  Decimal @default(0) @db.Decimal(10, 2)
  netPay      Decimal @default(0) @db.Decimal(10, 2)

  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_items")
}

// Enums

enum PaydayContractType {
  DEFINIDO
  INDEFINIDO
  OBRA_DETERMINADA
}

enum PaydayPaymentMode {
  TIEMPO // Hourly/Salary
  TAREA // Destajo
}

enum PaydayEntryMethod {
  FACE_RECOGNITION
  FINGERPRINT
  NFC
  QR_DYNAMIC
  PIN_CODE
  MANUAL_ADMIN
}

enum ShiftStatus {
  OPEN
  COMPLETED
  REVIEW_NEEDED
  APPROVED
}

enum TaskStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PayrollStatus {
  DRAFT
  LOCKED
  PAID
}

// ============================================
// UPGRADE REQUESTS (Simple system for module/plan requests)
// ============================================

model UpgradeRequest {
  id String @id @default(cuid())

  // Who is requesting
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Current state
  currentPlan String

  // What they want
  requestedPlan          String?
  requestedModules       String[] // ["inventory", "pos", "payday"]
  requestedCreditTier    MotorCreditTier? // si requestedModules incluye "creditos"
  requestedApiAccess     Boolean? // null = no cambia; true/false = solicita activar/desactivar
  requestedExtraBranches Int              @default(0)
  extraUsers             Int              @default(0)
  extraPosStations       Int              @default(0)
  message                String?

  // Status
  status    String  @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote String?

  // Timestamps
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  processedBy String?

  @@index([clientId])
  @@index([status])
  @@map("upgrade_requests")
}

model KioskSession {
  id         String  @id @default(cuid())
  clientId   String?
  status     String  @default("PENDING") // PENDING, SCANNED, COMPLETED, EXPIRED
  employeeId String?
  action     String? // CHECK_IN, CHECK_OUT, BREAK_START, BREAK_END

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([status])
  @@map("kiosk_sessions")
}

// ============================================
// ACID COMPLIANCE - CART RESERVATIONS
// ============================================

model CartReservation {
  id String @id @default(cuid())

  // Session tracking
  sessionId String // POS session or user session ID

  // Product reference
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Reserved quantity
  quantity Decimal @db.Decimal(12, 4)

  // TTL - Auto-expires after 15 minutes
  expiresAt DateTime

  // Timestamps
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("cart_reservations")
}

// ============================================
// ACID COMPLIANCE - STOCK MOVEMENTS AUDIT
// ============================================

model StockMovement {
  id String @id @default(cuid())

  // Product reference
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Movement details
  type           String // "SALE", "PURCHASE", "ADJUSTMENT", "RETURN", "SYNC", "RESERVATION"
  quantity       Decimal @db.Decimal(12, 4)
  previousStock  Decimal @db.Decimal(12, 4)
  newStock       Decimal @db.Decimal(12, 4)
  productVersion Int // Snapshot of product version at transaction time

  // Context reference
  referenceId   String? // Invoice ID, PO ID, POS Transaction ID, etc.
  referenceType String? // "Invoice", "PurchaseOrder", "POSSale", "Adjustment"
  notes         String? @db.Text

  // User tracking
  createdById String?

  // Timestamps
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@index([referenceId, referenceType])
  @@index([type])
  @@map("stock_movements")
}

// ============================================
// ACID COMPLIANCE - POS OFFLINE TRANSACTIONS
// ============================================

model POSOfflineTransaction {
  id String @id @default(cuid())

  // Terminal/Client tracking
  terminalId String
  clientId   String

  // Offline identity
  localId        String   @unique // UUID generated offline for idempotency
  createdAtLocal DateTime // Timestamp when created offline

  // Sync tracking
  syncedAt DateTime? // When synced to server (null = pending)

  // Transaction data snapshot
  items Json // Snapshot of items sold [{productId, quantity, price}]
  total Decimal @db.Decimal(12, 2)

  // Conflict resolution
  hasConflict        Boolean   @default(false)
  conflictReason     String?   @db.Text
  conflictResolvedAt DateTime?
  resolvedBy         String?
  resolutionAction   String? // "APPLIED", "REJECTED", "PARTIAL"

  // User tracking
  createdById String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([terminalId])
  @@index([clientId])
  @@index([localId])
  @@index([hasConflict])
  @@index([syncedAt])
  @@map("pos_offline_transactions")
}

// ============================================
// LOGISTICS - ÓRDENES DE ENTREGA
// ============================================

enum DeliveryOrderStatus {
  DRAFT
  PENDING
  IN_PICKING
  READY_TO_SHIP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum OriginModeType {
  DIRECT
  FROM_INVOICE
  FROM_POS
}

model Carrier {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name     String
  ruc      String?
  phone    String?
  email    String?
  isActive Boolean @default(true)

  deliveryOrders DeliveryOrder[]
  drivers        Driver[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("carriers")
}

model Driver {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  carrierId String?
  carrier   Carrier? @relation(fields: [carrierId], references: [id])

  firstName String
  lastName  String
  phone     String?
  licenseNo String?
  isActive  Boolean @default(true)

  deliveryOrders DeliveryOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([carrierId])
  @@map("drivers")
}

model DeliveryOrder {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  code             String // OE-YYYY-NNNNNN per client
  status           DeliveryOrderStatus @default(DRAFT)
  // Headers
  priority         String              @default("Normal")
  purchaseOrderRef String?

  // Origin
  originMode      OriginModeType @default(DIRECT)
  linkedInvoiceId String? // FK to Invoice when FROM_INVOICE
  linkedPosId     String? // FK to POS transaction when FROM_POS

  // Recipient
  customerName     String
  customerPhone    String?
  customerEmail    String?
  customerRuc      String?
  deliveryLocation String?

  // Transporter (Manual)
  carrierName     String?
  driverName      String?
  driverIdDoc     String?
  driverLicense   String?
  vehiclePlate    String?
  insurancePolicy String?

  // Conditions
  shippingMode   String  @default("Terrestre")
  incoterm       String?
  controlledTemp Boolean @default(false)
  hazardousMat   Boolean @default(false)

  // Fees
  shippingCost    Decimal? @db.Decimal(12, 2)
  insuranceCost   Decimal? @db.Decimal(12, 2)
  deliveryAddress Json? // { text: string, lat?: number, lng?: number }

  // Assignment
  carrierId String?
  carrier   Carrier? @relation(fields: [carrierId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])

  // Scheduling
  scheduledDate DateTime?
  estimatedDate DateTime?
  deliveredAt   DateTime?

  // Fiscal
  emitInvoice Boolean @default(false)

  // Pricing
  subtotal    Decimal? @db.Decimal(12, 2)
  taxAmount   Decimal? @db.Decimal(12, 2)
  totalAmount Decimal? @db.Decimal(12, 2)

  // Inventory
  inventoryDeducted Boolean @default(false)

  // PDF / QR
  pdfUrl  String?
  qrToken String? @unique // HMAC token for public tracking

  // Notes
  notes         String? @db.Text
  internalNotes String? @db.Text

  // Tracking
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items         DeliveryOrderItem[]
  statusHistory DeliveryOrderStatusHistory[]
  events        DeliveryEvent[]
  scanLogs      QRScanLog[]

  @@unique([clientId, code])
  @@index([clientId])
  @@index([status])
  @@index([linkedInvoiceId])
  @@index([qrToken])
  @@map("delivery_orders")
}

model DeliveryOrderItem {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  productId   String?
  description String
  quantity    Decimal  @db.Decimal(12, 4)
  unitPrice   Decimal? @db.Decimal(12, 2)
  weightKg    Decimal? @db.Decimal(12, 2)
  dimensions  String?
  packaging   String?
  taxRate     Decimal? @db.Decimal(5, 4) // e.g. 0.0700 for 7% ITBMS
  taxAmount   Decimal? @db.Decimal(12, 2)
  lineTotal   Decimal? @db.Decimal(12, 2)

  // Extended product capture fields
  category     String? // GENERAL | ROPA | CALZADO | MUEBLES | ELECTRODOMESTICOS | ELECTRONICA | ALIMENTOS | INSUMOS | SERVICIOS | SOFTWARE
  sku          String? // Internal SKU
  barcode      String? // EAN-13 / UPC-A
  umc          String? // DGI UMC catalog: UND, KGM, HUR, LTR...
  cpbsCode     String? // CPBS DGI product/service code (e-invoicing)
  categoryMeta Json? // Dynamic fields per category (talla, color, marca, etc.)
  volWeight    Decimal? @db.Decimal(12, 2) // Calculated: (L×A×H)/5000 for logistics cost
  itemHash     String? // SHA-256(sku+price+taxRate+description) — integrity fingerprint

  @@index([deliveryOrderId])
  @@map("delivery_order_items")
}

model DeliveryOrderStatusHistory {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  fromStatus  DeliveryOrderStatus?
  toStatus    DeliveryOrderStatus
  notes       String?              @db.Text
  changedById String?

  createdAt DateTime @default(now())

  @@index([deliveryOrderId])
  @@map("delivery_order_status_history")
}

model DeliveryEvent {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  eventType  String // e.g. STATUS_CHANGE, PDF_GENERATED, QR_SCANNED
  fromStatus String?
  toStatus   String?

  actorType String // USER, DRIVER, SYSTEM
  actorId   String?
  actorName String? // Desnormalizado

  metadata  Json? // JSONB for autosufficiency
  timestamp DateTime @default(now())

  @@index([deliveryOrderId])
  @@index([eventType])
  @@map("delivery_events")
}

model QRScanLog {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  qrToken   String
  ip        String?
  userAgent String?
  metadata  Json?
  scannedAt DateTime @default(now())

  @@index([deliveryOrderId])
  @@index([qrToken])
  @@map("qr_scan_logs")
}

// ============================================
// TEAM ROLES & GRANULAR PERMISSIONS
// ============================================

model TeamRole {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name        String // e.g. "Chofer", "Operador", "Almacenista", etc.
  slug        String // e.g. "chofer", "operador"
  description String?
  isSystem    Boolean @default(false) // System-defined roles can't be deleted
  isActive    Boolean @default(true)

  // Permissions stored as JSON array for flexibility
  // Format: [{ module: "invoicing", actions: ["read", "create"] }, ...]
  permissions Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users TeamMember[]

  @@unique([clientId, slug])
  @@index([clientId])
  @@map("team_roles")
}

model TeamMember {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamRoleId String
  teamRole   TeamRole @relation(fields: [teamRoleId], references: [id], onDelete: Cascade)

  // Per-user permission overrides (JSON)
  // Allows admin to customize permissions beyond the role
  permissionOverrides Json? // { grants: [...], revokes: [...] }

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
  @@index([teamRoleId])
  @@map("team_members")
}

// ============================================
// SECURITY TOKENS - Password Reset, Account Setup, Email Verification
// ============================================

model SecurityToken {
  id        String            @id @default(cuid())
  tokenHash String // SHA-256 hash of the token (never store raw)
  type      SecurityTokenType
  userId    String?
  email     String // Email associated (for pre-user tokens like setup)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime          @default(now())

  // Optional: track which IP/device consumed it
  consumedIp        String?
  consumedUserAgent String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([email])
  @@index([type, email])
  @@index([expiresAt])
  @@map("security_tokens")
}

enum SecurityTokenType {
  PASSWORD_RESET
  ACCOUNT_SETUP
  EMAIL_VERIFICATION
}

// ============================================
// USER STATUS - Onboarding State Machine
// ============================================

enum UserStatus {
  UNVERIFIED        // Just registered, email not verified
  SETUP_PENDING     // Clicked email link, needs to set password
  PENDING_ONBOARDING // Password set, needs to select modules
  PENDING_APPROVAL  // Onboarding complete, waiting for admin
  ACTIVE            // Approved and active
  SUSPENDED         // Temporarily suspended
  DEACTIVATED       // Permanently deactivated
}

// PASSWORD RESET TOKENS
// ============================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique @default(cuid())
  type      String    @default("PASSWORD_RESET") // PASSWORD_RESET | ACCOUNT_VERIFICATION
  expiresAt DateTime
  usedAt    DateTime?
  createdBy String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ============================================
// MOTOR DE ENTIDADES & LEDGER FINANCIERO
// ============================================
// Subsistema tenant-scoped:
//   (a) Schema Builder de entidades con campos dinámicos
//   (b) Ledger financiero append-only con cargos, abonos, ajustes, lealtad
// Acceso restringido a tenants con ClientModuleAssignment(moduleKey="motor", status=ACTIVE).
// Convenciones del repo: clientId primero en índices compuestos, snake_case @@map,
// soft-delete via deletedAt (excepto en el ledger, que es inmutable por diseño).

enum MotorEntityKind {
  PERSON
  COMPANY
}

enum MotorMovementType {
  CHARGE // Cargo: deuda generada
  PAYMENT // Abono: pago recibido
  ADJUSTMENT_CREDIT // Ajuste positivo (crédito de cortesía / corrección)
  ADJUSTMENT_DEBIT // Ajuste negativo (corrección / reverso)
  LOYALTY_GRANT // Otorgar puntos / créditos de lealtad
  LOYALTY_REDEEM // Redimir puntos / créditos contra obligación
}

enum MotorLedgerSign {
  POSITIVE
  NEGATIVE
}

enum MotorAssignmentStatus {
  ACTIVE
  REVOKED
}

enum MotorFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

enum MotorFieldKindScope {
  PERSON
  COMPANY
  BOTH
}

// Tiers de pricing del Módulo de Créditos. Cada tier limita cuántos
// clientes del tenant pueden tener crédito otorgado simultáneamente
// (entidades activas con creditLimitCents != null). Bloqueo duro al
// exceder el límite; SUPER_ADMIN puede subir/bajar de tier.
enum MotorCreditTier {
  TIER_1 // hasta 50 clientes  — $49.99 / mes
  TIER_2 // hasta 100 clientes — $74.99 / mes
  TIER_3 // hasta 250 clientes — $99.99 / mes
}

// Periodicidad de cobro del plan. Los addons recurring se siguen cobrando
// mensual aunque el plan sea YEARLY — el período aplica al "compromiso"
// del plan, no a los addons.
enum BillingPeriod {
  MONTHLY
  YEARLY
}

// ============================================
// BI — Business Intelligence (Fase 1: Esencial)
// ============================================
//
// Solo BIAlert se materializa en Fase 1. Los modelos BIDashboard / BIWidget
// / BISavedSegment / BICampaign / BIForecast llegan en Fases 2-3 (ver
// docs/superpowers/specs/2026-05-10-bi-module-design.md).

enum BIAlertKind {
  THRESHOLD // "Avísame cuando métrica X cruce valor Y"
  ANOMALY // (Pro) detección 3σ vs media móvil
}

model BIAlert {
  id          String      @id @default(cuid())
  clientId    String
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  kind        BIAlertKind @default(THRESHOLD)
  /// Configuración de la alerta. Ej THRESHOLD:
  /// { metric: "sales_total", op: "<", value: 50000, period: "day" }
  config      Json
  isActive    Boolean     @default(true)
  lastFiredAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([clientId, isActive])
  @@map("bi_alerts")
}

// ============================================
// BI Pro — Dashboards personalizados (Fase 2)
// ============================================

model BIDashboard {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  /// Layout grid: { cols: 12, rows: [{widgetId, x, y, w, h}, ...] }
  /// Lo persiste el editor — la página lo respeta tal cual.
  layout    Json
  isDefault Boolean @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  widgets BIWidget[]

  @@index([clientId])
  @@map("bi_dashboards")
}

model BIWidget {
  id          String   @id @default(cuid())
  dashboardId String
  dashboard   BIDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  /// "kpi" | "line" | "bar" | "pie" | "table"
  type        String
  title       String
  /// BIQuery serializado (measures, dimensions, filters, dateRange)
  query       Json
  /// Opciones visuales (colores, formatters, etc.) — opcional
  options     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dashboardId])
  @@map("bi_widgets")
}

// ============================================
// BI Pro — Segmentos, Campañas, Forecasts (Fase 3)
// ============================================

model BISavedSegment {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  /// "customer" por ahora; "product" llega en Fase 4
  entity      String   @default("customer")
  /// Reglas Json: ver SegmentRule en alert.service
  rules       Json
  cachedCount Int      @default(0)
  refreshedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns BICampaign[]

  @@index([clientId])
  @@map("bi_segments")
}

model BICampaign {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  segmentId   String
  segment     BISavedSegment @relation(fields: [segmentId], references: [id])
  /// "whatsapp" | "email"
  channel     String
  message     String
  /// "DRAFT" | "SCHEDULED" | "SENT" | "FAILED"
  status      String   @default("DRAFT")
  scheduledAt DateTime?
  sentAt      DateTime?
  recipients  Int      @default(0)
  conversions Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, status])
  @@map("bi_campaigns")
}

model BIForecast {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// "sales_total" | "demand_<sku>" | "customer_churn"
  metric      String
  /// "day" | "week" | "month"
  granularity String   @default("day")
  /// [{date, predicted, lower, upper}]
  data        Json
  computedAt  DateTime @default(now())

  @@index([clientId, metric, granularity])
  @@map("bi_forecasts")
}

// DEPRECATED en v1.1: el Motor ahora es infraestructura universal — opera
// para todos los tenants automáticamente (deduplicación de entidades en
// facturación/POS, ledger en background). El acceso al panel de
// configuración avanzada se controla a nivel de USUARIO con MotorUserAccess.
// Esta tabla se conserva por compatibilidad de datos pero ya no gateaa
// nada en código nuevo.
model ClientModuleAssignment {
  id         String                @id @default(cuid())
  clientId   String
  moduleKey  String // "motor" en v1
  status     MotorAssignmentStatus @default(ACTIVE)
  assignedAt DateTime              @default(now())
  revokedAt  DateTime?
  assignedBy String // userId del SUPER_ADMIN que asignó
  notes      String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, moduleKey])
  @@index([clientId, status])
  @@index([moduleKey, status])
  @@map("client_module_assignments")
}

// Acceso al panel de configuración del Motor a nivel de USUARIO.
// El Super Admin selecciona usuarios concretos (de cualquier tenant) que
// pueden ver y operar la UI completa: Schema Builder, gestión de
// entidades, ajustes manuales, créditos, lealtad, comprobantes.
// Los usuarios sin MotorUserAccess solo ven el flujo implícito
// (autocompletado en facturación, clientes recientes, deduplicación).
model MotorUserAccess {
  id        String                @id @default(cuid())
  // userId es global; se vincula también a clientId para query rápido
  userId    String                @unique
  clientId  String
  status    MotorAssignmentStatus @default(ACTIVE)
  grantedAt DateTime              @default(now())
  revokedAt DateTime?
  grantedBy String // userId del SUPER_ADMIN que concedió
  notes     String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
  @@index([status])
  @@map("motor_user_access")
}

// Entidad financiera del tenant (persona o empresa).
// Core fields no eliminables; campos dinámicos en customFields validados contra
// MotorEntityFieldDefinition.
model MotorEntity {
  id       String          @id @default(cuid())
  // Multi-tenant: SIEMPRE primero en queries
  clientId String
  kind     MotorEntityKind

  // Core fields (no eliminables, requeridos por el brief)
  displayName    String // nombre completo o razón social
  documentType   String? // CEDULA | RUC | PASSPORT | OTHER
  documentNumber String? // cédula o RUC
  primaryEmail   String?
  primaryPhone   String?
  isActive       Boolean @default(true)

  // Configuración financiera
  creditLimitCents   BigInt? // null = sin límite
  paymentDueAt       DateTime? // fecha tope para próxima obligación
  loyaltyPointsCents BigInt    @default(0) // saldo derivado, denormalizado para UI rápida

  // Campos dinámicos validados contra MotorEntityFieldDefinition
  customFields Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client        Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ledgerEntries MotorLedgerEntry[]
  outgoingRels  MotorEntityRelation[] @relation("MotorRelFrom")
  incomingRels  MotorEntityRelation[] @relation("MotorRelTo")

  // PlentyPay Wallet & Pagos (nuevo)
  wallet              Wallet?           // 1 wallet por entidad (comprador o comercio)
  merchantSettlements SettlementBatch[] // si esta entidad es un comercio del marketplace

  @@index([clientId, kind, deletedAt])
  @@index([clientId, displayName])
  @@index([clientId, documentNumber])
  @@index([clientId, isActive])
  @@map("motor_entities")
}

// Metadata de campos dinámicos del Schema Builder.
// El slug es inmutable una vez referenciado por entidades (validación a nivel app).
model MotorEntityFieldDefinition {
  id        String              @id @default(cuid())
  clientId  String
  slug      String // snake_case, validado contra RESERVED_SLUGS
  label     String
  type      MotorFieldType
  required  Boolean             @default(false)
  options   Json? // SELECT: [{value,label}]
  kindScope MotorFieldKindScope @default(BOTH)
  isActive  Boolean             @default(true)
  sortOrder Int                 @default(0)
  notes     String? // documentación visible al admin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, slug])
  @@index([clientId, isActive, kindScope])
  @@map("motor_entity_field_definitions")
}

// Relaciones genéricas entre entidades del mismo tenant.
// relationType es free-text (e.g. "referred_by", "guarantor_of", "legal_rep_of").
model MotorEntityRelation {
  id           String   @id @default(cuid())
  clientId     String
  fromEntityId String
  toEntityId   String
  relationType String
  metadata     Json?
  createdAt    DateTime @default(now())
  createdById  String

  fromEntity MotorEntity @relation("MotorRelFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity   MotorEntity @relation("MotorRelTo", fields: [toEntityId], references: [id], onDelete: Cascade)
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, fromEntityId, toEntityId, relationType])
  @@index([clientId, fromEntityId])
  @@index([clientId, toEntityId])
  @@map("motor_entity_relations")
}

// Ledger inmutable. Append-only enforced por trigger Postgres BEFORE UPDATE/DELETE
// (ver migration.sql). Reversiones se modelan como entries compensatorios independientes
// con compensatesEntryId apuntando al original.
model MotorLedgerEntry {
  id                  String            @id @default(cuid())
  clientId            String
  entityId            String
  movementType        MotorMovementType
  sign                MotorLedgerSign
  amountCents         BigInt // SIEMPRE positivo; sign determina dirección
  runningBalanceCents BigInt // post-movimiento, denormalizado para O(1) lookup
  currency            String            @default("USD") // economía panameña dolarizada; PAB queda disponible si algún día se necesita
  reference           String? // # factura, # recibo externo, etc.
  description         String?
  metadata            Json?
  compensatesEntryId  String? // self-FK: este entry reversa otro
  createdById         String
  createdAt           DateTime          @default(now())

  entity      MotorEntity        @relation(fields: [entityId], references: [id], onDelete: Restrict)
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  compensates MotorLedgerEntry?  @relation("MotorLedgerCompensation", fields: [compensatesEntryId], references: [id])
  reversedBy  MotorLedgerEntry[] @relation("MotorLedgerCompensation")

  @@index([clientId, entityId, createdAt])
  @@index([clientId, movementType, createdAt])
  @@index([clientId, compensatesEntryId])
  @@map("motor_ledger_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// ─────────────────────────────────────────────────────────────────────────
// PLENTYPAY: PAYMENT CORE + LEDGER (v2 — revisado tras feedback arquitectónico)
// ─────────────────────────────────────────────────────────────────────────
// El primer borrador de este bloque (v1) usaba una única tabla PaymentTransaction
// y escribía directo a MotorLedgerEntry. Tras una revisión arquitectónica externa
// (ver services/wallet-ledger/README.md, sección "Historial de diseño"), se
// separó en dos bounded contexts independientes, tal como PlentyPay los necesita:
//
//   PAYMENT CORE (orquestación — "qué pasó con el intento de cobro")
//     PaymentIntent → Payment → PaymentAttempt
//
//   LEDGER (verdad financiera — "qué significa contablemente que haya pasado")
//     LedgerAccount → LedgerTransaction → LedgerEntry (DEBIT/CREDIT)
//
// Principio clave: Payment State ≠ Financial State. Un Payment puede estar
// CAPTURED mientras su LedgerTransaction sigue sin liquidarse al comercio.
// El Motor original (MotorLedgerEntry, créditos/lealtad) NO se toca — sigue
// sirviendo su propósito original. Este ledger nuevo es la verdad financiera
// específicamente para dinero que se mueve de verdad (pagos, fees, settlement).

enum PaymentIntentStatus {
  CREATED
  REQUIRES_ACTION // el riel necesita un paso del usuario (QR de Yappy, 3-D Secure)
  PROCESSING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
  EXPIRED
  UNKNOWN // resultado no confirmado tras timeout — NUNCA asumir FAILED ni CAPTURED
}

enum PaymentAttemptStatus {
  CREATED
  PROCESSING
  AUTHORIZED
  CAPTURED
  FAILED
  UNKNOWN
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerTransactionStatus {
  DRAFT
  VALIDATING
  POSTED // inmutable a partir de aquí — ver trigger en la migración manual
  REJECTED
}

enum PaymentRail {
  WALLET_INTERNAL
  YAPPY
  TELERED_CLAVE
  CARD_VISA
  CARD_MASTERCARD
  APPLE_PAY
  GOOGLE_PAY
  QR_INTEROPERABLE
}

/// Intención de cobro. Vive independiente de cuántas veces se reintente.
model PaymentIntent {
  id                 String              @id @default(cuid()) // ver MIGRATION_STATUS.md — nota sobre UUIDv7
  clientId           String
  customerEntityId   String? // MotorEntity que paga, si se conoce
  amountCents        BigInt
  currency           String              @default("USD")
  status             PaymentIntentStatus @default(CREATED)
  paymentMethodType  PaymentRail
  idempotencyKey     String
  requestHash        String? // hash del payload de creación — detecta reintentos con distinto contenido bajo la misma key (ver documento 03 + feedback punto 9)
  reference          String? // referencia de negocio (orden, terminal, factura) — para conciliar y dar soporte
  metadata           Json? // ej. { payerUserId, terminalId } — el pagador se guarda aquí hasta que exista el mapeo User↔MotorEntity
  riskScore          Int?
  expiresAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([clientId, idempotencyKey])
  @@map("payment_intents")
}

/// Transacción financiera creada a partir de una PaymentIntent. Separada de
/// PaymentAttempt porque un Payment puede requerir varios intentos (timeout,
/// reintento manual) antes de resolverse.
model Payment {
  id                  String              @id @default(cuid())
  paymentIntentId     String
  clientId            String
  merchantEntityId    String? // comercio del marketplace que recibe el pago, si aplica
  capturedAmountCents BigInt              @default(0)
  refundedAmountCents BigInt              @default(0)
  status              PaymentIntentStatus @default(CREATED)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  intent             PaymentIntent      @relation(fields: [paymentIntentId], references: [id])
  client             Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  attempts           PaymentAttempt[]
  ledgerTransactions LedgerTransaction[]
  settlementItem     SettlementItem?

  @@index([clientId, status, createdAt])
  @@map("payments")
}

/// Un intento concreto contra un riel externo. attemptNumber empieza en 1.
/// UNKNOWN existe porque un timeout de Yappy/TELERED/PSP NO es lo mismo que FAILED
/// — el dinero puede haberse movido del lado del riel sin que la respuesta llegara
/// (ver documento 03 + feedback punto 8). La reconciliación (a construir) resuelve
/// UNKNOWN comparando contra el webhook o una consulta de estado posterior.
model PaymentAttempt {
  id            String               @id @default(cuid())
  paymentId     String
  rail          PaymentRail
  externalRef   String?
  attemptNumber Int
  status        PaymentAttemptStatus @default(CREATED)
  failureCode   String?
  rawResponse   Json?
  createdAt     DateTime             @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId, attemptNumber])
  @@index([externalRef])
  @@map("payment_attempts")
}

/// Terminal de cobro de un comercio (tenant). Su publicCode es lo ÚNICO que viaja en el QR
/// y en el tag NFC: un código opaco y no adivinable. El monto NUNCA va en el tag/QR, y el
/// servidor resuelve a qué comercio pertenece — un tag regrabado o un sticker encima solo
/// puede apuntar a otra terminal REAL, y la app muestra el nombre verificado antes de pagar.
model PaymentTerminal {
  id          String   @id @default(cuid())
  clientId    String
  publicCode  String   @unique
  label       String
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, isActive])
  @@map("payment_terminals")
}

/// Política de fees paramétrica — nunca se hardcodea "el comercio recibe 97.86%".
/// Ver documento 03 + feedback punto 6 (Fee Engine).
model FeePolicy {
  id                       String       @id @default(cuid())
  clientId                 String
  name                     String
  rail                     PaymentRail?
  fixedFeeCents            BigInt       @default(0)
  percentageFeeBasisPoints Int          @default(0) // 100 = 1.00%
  bornBy                   String // "MERCHANT" | "CUSTOMER" | "PLATFORM"
  active                   Boolean      @default(true)
  createdAt                DateTime     @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, active])
  @@map("fee_policies")
}

// ── LEDGER: verdad financiera, doble entrada, inmutable una vez POSTED ──────

/// Cuenta contable. NO es "el saldo de un usuario" — es una cuenta en el sentido
/// contable clásico (pasivo, activo, ingreso). El saldo de una cuenta se calcula
/// SIEMPRE como SUM(CREDIT) - SUM(DEBIT) sobre sus LedgerEntry, nunca se guarda
/// como columna mutable aquí (eso es lo que hace el modelo Wallet, como caché
/// de lectura rápida — ver más abajo).
model LedgerAccount {
  id          String   @id @default(cuid())
  clientId    String
  // "PLATFORM" para cuentas internas de PlentyPay (fees, impuestos por pagar).
  // NO se usa null: Postgres no garantiza unicidad entre múltiples NULL en un
  // índice único, lo que rompería la deduplicación de estas cuentas — ver
  // MIGRATION_STATUS.md.
  entityId    String
  accountType String // "MERCHANT_PAYABLE" | "PLATFORM_FEES" | "TAX_PAYABLE" | "CUSTOMER_RECEIVABLE" | "WALLET_INTERNAL" | ...
  currency    String   @default("USD")
  createdAt   DateTime @default(now())

  client  Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([clientId, entityId, accountType, currency])
  @@map("ledger_accounts")
}

/// Agrupa N LedgerEntry que deben balancear entre sí (SUM(DEBIT) = SUM(CREDIT)).
/// DRAFT → VALIDATING → POSTED (inmutable) | REJECTED. Un error después de POSTED
/// se corrige con una transacción de REVERSO (reversalOfId), nunca con UPDATE/DELETE
/// — ver el trigger de base de datos en prisma/migrations/*_ledger_invariants/.
model LedgerTransaction {
  id              String                  @id @default(cuid())
  clientId        String
  paymentId       String?
  transactionType String // "PAYMENT" | "REFUND" | "FEE" | "SETTLEMENT" | "ADJUSTMENT"
  referenceType   String?
  referenceId     String?
  currency        String                  @default("USD")
  description     String?
  status          LedgerTransactionStatus @default(DRAFT)
  reversalOfId    String?
  createdAt       DateTime                @default(now())
  postedAt        DateTime?

  client     Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payment    Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  entries    LedgerEntry[]
  reversalOf LedgerTransaction?  @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals  LedgerTransaction[] @relation("LedgerReversal")

  @@index([clientId, status, createdAt])
  @@map("ledger_transactions")
}

/// Una línea de doble entrada. amountCents SIEMPRE positivo — el signo/dirección
/// lo da entryType exclusivamente (feedback punto 2: nunca dos fuentes de verdad
/// para el signo). La suma de DEBIT y la suma de CREDIT de una misma
/// LedgerTransaction deben coincidir siempre que status = POSTED.
model LedgerEntry {
  id                  String          @id @default(cuid())
  ledgerTransactionId String
  accountId           String
  entryType           LedgerEntryType
  amountCents         BigInt
  createdAt           DateTime        @default(now())

  transaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  account     LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([ledgerTransactionId])
  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

// ── WALLET: caché de saldo de lectura rápida para la cuenta WALLET_INTERNAL ──
// (sin cambios de fondo respecto al primer borrador — sigue siendo válido como
// capa de lectura optimista; su saldo debe reconciliar contra LedgerAccount +
// LedgerEntry de tipo WALLET_INTERNAL para la misma entidad).

enum WalletHoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

model Wallet {
  id                     String   @id @default(cuid())
  clientId               String
  entityId               String   @unique
  currency               String   @default("USD")
  availableBalanceCents  BigInt   @default(0)
  heldBalanceCents       BigInt   @default(0)
  pendingSettlementCents BigInt   @default(0)
  version                Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  entity MotorEntity  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  holds  WalletHold[]

  @@index([clientId])
  @@map("wallets")
}

model WalletHold {
  id             String           @id @default(cuid())
  walletId       String
  amountCents    BigInt
  status         WalletHoldStatus @default(ACTIVE)
  reason         String?
  idempotencyKey String?          @unique
  expiresAt      DateTime?
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@map("wallet_holds")
}

// ── SETTLEMENT: liquidación a comercios del marketplace ─────────────────────

enum SettlementBatchStatus {
  OPEN
  PROCESSING
  PAID
  FAILED
}

model SettlementBatch {
  id                String                @id @default(cuid())
  clientId          String
  merchantEntityId  String
  status            SettlementBatchStatus @default(OPEN)
  grossAmountCents  BigInt                @default(0)
  commissionCents   BigInt                @default(0)
  netAmountCents    BigInt                @default(0)
  payoutRail        PaymentRail?
  payoutExternalRef String?
  periodStart       DateTime
  periodEnd         DateTime
  paidAt            DateTime?
  createdAt         DateTime              @default(now())

  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  merchantEntity MotorEntity      @relation(fields: [merchantEntityId], references: [id], onDelete: Restrict)
  items          SettlementItem[]

  @@index([clientId, merchantEntityId, status])
  @@map("settlement_batches")
}

model SettlementItem {
  id                String @id @default(cuid())
  settlementBatchId String
  paymentId         String

  batch   SettlementBatch @relation(fields: [settlementBatchId], references: [id], onDelete: Cascade)
  payment Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([paymentId])
  @@map("settlement_items")
}
