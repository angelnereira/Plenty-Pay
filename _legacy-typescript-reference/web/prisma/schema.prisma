// ============================================
// CRM & EMAIL MARKETING
// ============================================

model EmailCampaign {
  id            String   @id @default(cuid())
  subject       String
  content       String   @db.Text
  targetPlans   String[] // Array of plan types to target
  targetUserIds String[] // specific user IDs to target
  targetEmails  String[] // arbitrary email addresses (not in DB)
  fromEmail     String? // custom sender address override

  status      String    @default("DRAFT") // DRAFT, SENT, FAILED
